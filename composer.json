{
    "name": "kite-co/wp-sync",
    "description": "Pull a live WordPress site to local in one command (database, plugins, themes, uploads), or push it back. WP-CLI package over SSH and rsync.",
	"type": "wp-cli-package",
    "homepage": "https://github.com/kite-co-code/wp-sync",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "WpSync\\": "src/"
        },
        "files": [ "command.php" ]
    },
    "authors": [
        {
            "name": "Jerome Toole"
        }
    ],
    "require": {
        "wp-cli/mustangostang-spyc": "^0.6.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11"
    },
    "scripts": {
        "test": "phpunit"
    }
}
